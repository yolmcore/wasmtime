;; =============================================================================
;; YOLM FORK: Turin AVX-512 Helpers
;; =============================================================================

;; Helper to convert Xmm to RegMem for Turin instructions
(decl turin_xmm_to_reg_mem (Xmm) RegMem)
(extern constructor turin_xmm_to_reg_mem turin_xmm_to_reg_mem)

;; Helper to convert XmmMem to RegMem for Turin instructions
(decl turin_xmm_mem_to_reg_mem (XmmMem) RegMem)
(extern constructor turin_xmm_mem_to_reg_mem turin_xmm_mem_to_reg_mem)

;; Helper for creating Turin AVX-512 ALU instructions (unmasked, 32-bit elements)
;; Returns an Xmm register with the result
(decl turin_alu_d (Avx512AluOp Xmm XmmMem) Xmm)
(rule (turin_alu_d op src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512Alu op
                                                (OperandSize.Size32)
                                                dst
                                                src1
                                                src2_rm
                                                (option_mask_reg_none)
                                                (MergeMode.Zeroing)))))
        dst))

;; Helper for creating Turin AVX-512 ALU instructions (unmasked, 64-bit elements)
(decl turin_alu_q (Avx512AluOp Xmm XmmMem) Xmm)
(rule (turin_alu_q op src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512Alu op
                                                (OperandSize.Size64)
                                                dst
                                                src1
                                                src2_rm
                                                (option_mask_reg_none)
                                                (MergeMode.Zeroing)))))
        dst))

;; Specific 512-bit ALU operations (32-bit elements - I32X16)

(decl turin_vpaddd (Xmm XmmMem) Xmm)
(rule (turin_vpaddd src1 src2) (turin_alu_d (Avx512AluOp.Vpaddd) src1 src2))

(decl turin_vpsubd (Xmm XmmMem) Xmm)
(rule (turin_vpsubd src1 src2) (turin_alu_d (Avx512AluOp.Vpsubd) src1 src2))

(decl turin_vpmulld (Xmm XmmMem) Xmm)
(rule (turin_vpmulld src1 src2) (turin_alu_d (Avx512AluOp.Vpmulld) src1 src2))

(decl turin_vpandd (Xmm XmmMem) Xmm)
(rule (turin_vpandd src1 src2) (turin_alu_d (Avx512AluOp.Vpandd) src1 src2))

(decl turin_vpord (Xmm XmmMem) Xmm)
(rule (turin_vpord src1 src2) (turin_alu_d (Avx512AluOp.Vpord) src1 src2))

(decl turin_vpxord (Xmm XmmMem) Xmm)
(rule (turin_vpxord src1 src2) (turin_alu_d (Avx512AluOp.Vpxord) src1 src2))

(decl turin_vpminsd (Xmm XmmMem) Xmm)
(rule (turin_vpminsd src1 src2) (turin_alu_d (Avx512AluOp.Vpminsd) src1 src2))

(decl turin_vpmaxsd (Xmm XmmMem) Xmm)
(rule (turin_vpmaxsd src1 src2) (turin_alu_d (Avx512AluOp.Vpmaxsd) src1 src2))

(decl turin_vpminud (Xmm XmmMem) Xmm)
(rule (turin_vpminud src1 src2) (turin_alu_d (Avx512AluOp.Vpminud) src1 src2))

(decl turin_vpmaxud (Xmm XmmMem) Xmm)
(rule (turin_vpmaxud src1 src2) (turin_alu_d (Avx512AluOp.Vpmaxud) src1 src2))

;; Specific 512-bit ALU operations (64-bit elements - I64X8)

(decl turin_vpaddq (Xmm XmmMem) Xmm)
(rule (turin_vpaddq src1 src2) (turin_alu_q (Avx512AluOp.Vpaddq) src1 src2))

(decl turin_vpsubq (Xmm XmmMem) Xmm)
(rule (turin_vpsubq src1 src2) (turin_alu_q (Avx512AluOp.Vpsubq) src1 src2))

(decl turin_vpmullq (Xmm XmmMem) Xmm)
(rule (turin_vpmullq src1 src2) (turin_alu_q (Avx512AluOp.Vpmullq) src1 src2))

;; VPMULUDQ - 32x32→64 unsigned multiply
;; Takes low 32-bits of each 64-bit element and produces 64-bit result
(decl turin_vpmuludq (Xmm XmmMem) Xmm)
(rule (turin_vpmuludq src1 src2) (turin_alu_q (Avx512AluOp.Vpmuludq) src1 src2))

;; VPMULDQ - 32x32→64 signed multiply
;; Takes low 32-bits of each 64-bit element and produces 64-bit result
(decl turin_vpmuldq (Xmm XmmMem) Xmm)
(rule (turin_vpmuldq src1 src2) (turin_alu_q (Avx512AluOp.Vpmuldq) src1 src2))

(decl turin_vpandq (Xmm XmmMem) Xmm)
(rule (turin_vpandq src1 src2) (turin_alu_q (Avx512AluOp.Vpandq) src1 src2))

(decl turin_vporq (Xmm XmmMem) Xmm)
(rule (turin_vporq src1 src2) (turin_alu_q (Avx512AluOp.Vporq) src1 src2))

(decl turin_vpxorq (Xmm XmmMem) Xmm)
(rule (turin_vpxorq src1 src2) (turin_alu_q (Avx512AluOp.Vpxorq) src1 src2))

(decl turin_vpminsq (Xmm XmmMem) Xmm)
(rule (turin_vpminsq src1 src2) (turin_alu_q (Avx512AluOp.Vpminsq) src1 src2))

(decl turin_vpmaxsq (Xmm XmmMem) Xmm)
(rule (turin_vpmaxsq src1 src2) (turin_alu_q (Avx512AluOp.Vpmaxsq) src1 src2))

(decl turin_vpminuq (Xmm XmmMem) Xmm)
(rule (turin_vpminuq src1 src2) (turin_alu_q (Avx512AluOp.Vpminuq) src1 src2))

(decl turin_vpmaxuq (Xmm XmmMem) Xmm)
(rule (turin_vpmaxuq src1 src2) (turin_alu_q (Avx512AluOp.Vpmaxuq) src1 src2))

;; =============================================================================
;; YOLM FORK: Turin AVX-512 Masked Operations
;; =============================================================================
;;
;; These helpers support masked AVX-512 operations using k-registers.
;; The mask determines which lanes are updated:
;; - Merging mode: lanes where mask bit is 0 keep their value from passthrough
;; - Zeroing mode: lanes where mask bit is 0 are set to zero
;;
;; Usage:
;;   (turin_masked_vpaddq mask src1 src2 passthrough) ; merging mode
;;   (turin_zeroing_vpaddq mask src1 src2)            ; zeroing mode

;; Helper type for mask registers (k1-k7)
;; The mask is passed as a Reg which should be allocated to a k-register
(decl turin_mask_reg (Reg) OptionMaskReg)
(extern constructor turin_mask_reg turin_mask_reg)

;; Generic masked ALU (32-bit elements)
;; Strategy: Execute with zeroing mask, then blend with passthrough
;; This works around merge mode requiring dst to be pre-initialized
(decl turin_masked_alu_d (Avx512AluOp Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_alu_d op mask src1 src2 passthrough)
      ;; Execute operation with zeroing mode - masked-off lanes become 0
      (let ((raw_result Xmm (turin_zeroing_alu_d op mask src1 src2)))
        ;; Blend: where mask=1 take raw_result, where mask=0 take passthrough
        (turin_vpblendmd mask passthrough (xmm_to_xmm_mem raw_result))))

;; Generic masked ALU (64-bit elements)
;; Strategy: Execute with zeroing mask, then blend with passthrough
(decl turin_masked_alu_q (Avx512AluOp Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_alu_q op mask src1 src2 passthrough)
      ;; Execute operation with zeroing mode - masked-off lanes become 0
      (let ((raw_result Xmm (turin_zeroing_alu_q op mask src1 src2)))
        ;; Blend: where mask=1 take raw_result, where mask=0 take passthrough
        (turin_vpblendmq mask passthrough (xmm_to_xmm_mem raw_result))))

;; Generic zeroing ALU (32-bit elements, zeroing mode)
(decl turin_zeroing_alu_d (Avx512AluOp Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_alu_d op mask src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512Alu op
                                                (OperandSize.Size32)
                                                dst
                                                src1
                                                src2_rm
                                                mask_reg
                                                (MergeMode.Zeroing)))))
        dst))

;; Generic zeroing ALU (64-bit elements, zeroing mode)
(decl turin_zeroing_alu_q (Avx512AluOp Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_alu_q op mask src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512Alu op
                                                (OperandSize.Size64)
                                                dst
                                                src1
                                                src2_rm
                                                mask_reg
                                                (MergeMode.Zeroing)))))
        dst))

;; Masked add operations (I32X16)
(decl turin_masked_vpaddd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpaddd mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpaddd) mask src1 src2 passthrough))

(decl turin_zeroing_vpaddd (Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_vpaddd mask src1 src2)
      (turin_zeroing_alu_d (Avx512AluOp.Vpaddd) mask src1 src2))

;; Masked add operations (I64X8)
(decl turin_masked_vpaddq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpaddq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpaddq) mask src1 src2 passthrough))

(decl turin_zeroing_vpaddq (Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_vpaddq mask src1 src2)
      (turin_zeroing_alu_q (Avx512AluOp.Vpaddq) mask src1 src2))

;; Masked subtract operations (I32X16)
(decl turin_masked_vpsubd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsubd mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpsubd) mask src1 src2 passthrough))

(decl turin_zeroing_vpsubd (Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_vpsubd mask src1 src2)
      (turin_zeroing_alu_d (Avx512AluOp.Vpsubd) mask src1 src2))

;; Masked subtract operations (I64X8)
(decl turin_masked_vpsubq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsubq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpsubq) mask src1 src2 passthrough))

(decl turin_zeroing_vpsubq (Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_vpsubq mask src1 src2)
      (turin_zeroing_alu_q (Avx512AluOp.Vpsubq) mask src1 src2))

;; Masked multiply operations (I32X16)
(decl turin_masked_vpmulld (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpmulld mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpmulld) mask src1 src2 passthrough))

(decl turin_zeroing_vpmulld (Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_vpmulld mask src1 src2)
      (turin_zeroing_alu_d (Avx512AluOp.Vpmulld) mask src1 src2))

;; Masked multiply operations (I64X8)
(decl turin_masked_vpmullq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpmullq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpmullq) mask src1 src2 passthrough))

(decl turin_zeroing_vpmullq (Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_vpmullq mask src1 src2)
      (turin_zeroing_alu_q (Avx512AluOp.Vpmullq) mask src1 src2))

;; Masked AND operations (I32X16 / I64X8)
(decl turin_masked_vpandd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpandd mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpandd) mask src1 src2 passthrough))

(decl turin_masked_vpandq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpandq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpandq) mask src1 src2 passthrough))

;; Masked OR operations (I32X16 / I64X8)
(decl turin_masked_vpord (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpord mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpord) mask src1 src2 passthrough))

(decl turin_masked_vporq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vporq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vporq) mask src1 src2 passthrough))

;; Masked XOR operations (I32X16 / I64X8)
(decl turin_masked_vpxord (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpxord mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpxord) mask src1 src2 passthrough))

(decl turin_masked_vpxorq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpxorq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpxorq) mask src1 src2 passthrough))

;; Masked min/max operations (I32X16)
(decl turin_masked_vpminsd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpminsd mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpminsd) mask src1 src2 passthrough))

(decl turin_masked_vpmaxsd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpmaxsd mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpmaxsd) mask src1 src2 passthrough))

;; Masked min/max operations (I64X8)
(decl turin_masked_vpminsq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpminsq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpminsq) mask src1 src2 passthrough))

(decl turin_masked_vpmaxsq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpmaxsq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpmaxsq) mask src1 src2 passthrough))

;; =============================================================================
;; Turin AVX-512 Blend Operations (VPBLENDMD/VPBLENDMQ)
;; =============================================================================
;;
;; These implement the blend pattern: select lanes based on mask bits.
;; blend(mask, if_true, if_false) -> for each lane, select if_true if mask=1, else if_false

;; VPBLENDMD: Blend src1 and src2 based on mask.
;; - When k[i]=1: select src2 (if_false)
;; - When k[i]=0: select src1 (if_true)
;; Note: Merging mode is used so unmasked lanes take from src1, not zeroed.
(decl turin_vpblendmd (Reg Xmm XmmMem) Xmm)
(rule (turin_vpblendmd mask if_true if_false)
      (let ((dst WritableXmm (temp_writable_xmm))
            (if_false_rm RegMem (turin_xmm_mem_to_reg_mem if_false))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpblendmd)
                                                (OperandSize.Size32)
                                                dst
                                                if_true
                                                if_false_rm
                                                mask_reg
                                                (MergeMode.Merging)))))
        dst))

;; VPBLENDMQ: Blend src1 and src2 based on mask.
;; - When k[i]=1: select src2 (if_false)
;; - When k[i]=0: select src1 (if_true)
;; Note: Merging mode is used so unmasked lanes take from src1, not zeroed.
(decl turin_vpblendmq (Reg Xmm XmmMem) Xmm)
(rule (turin_vpblendmq mask if_true if_false)
      (let ((dst WritableXmm (temp_writable_xmm))
            (if_false_rm RegMem (turin_xmm_mem_to_reg_mem if_false))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpblendmq)
                                                (OperandSize.Size64)
                                                dst
                                                if_true
                                                if_false_rm
                                                mask_reg
                                                (MergeMode.Merging)))))
        dst))

;; =============================================================================
;; Turin AVX-512 Compare Operations (VPCMPD/VPCMPQ)
;; =============================================================================
;;
;; These compare 512-bit vectors and produce a mask in a k-register.
;; The result is a Reg that should be allocated to k1-k7.
;;
;; Conditions (Avx512Cond):
;;   Eq = 0, Lt = 1, Le = 2, Neq = 4, Ge = 5, Gt = 6

(decl turin_vpcmpd (Avx512Cond Xmm XmmMem) Reg)
(rule (turin_vpcmpd cond src1 src2)
      (let ((dst WritableReg (temp_writable_reg $I64))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512Cmp (OperandSize.Size32)
                                                 dst
                                                 src1
                                                 src2_rm
                                                 cond
                                                 (option_mask_reg_none)))))
        dst))

(decl turin_vpcmpq (Avx512Cond Xmm XmmMem) Reg)
(rule (turin_vpcmpq cond src1 src2)
      (let ((dst WritableReg (temp_writable_reg $I64))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512Cmp (OperandSize.Size64)
                                                 dst
                                                 src1
                                                 src2_rm
                                                 cond
                                                 (option_mask_reg_none)))))
        dst))

;; Specific comparison helpers for common conditions (I32X16)
(decl turin_vpcmpeqd (Xmm XmmMem) Reg)
(rule (turin_vpcmpeqd src1 src2) (turin_vpcmpd (Avx512Cond.Eq) src1 src2))

(decl turin_vpcmpltd (Xmm XmmMem) Reg)
(rule (turin_vpcmpltd src1 src2) (turin_vpcmpd (Avx512Cond.Lt) src1 src2))

(decl turin_vpcmpled (Xmm XmmMem) Reg)
(rule (turin_vpcmpled src1 src2) (turin_vpcmpd (Avx512Cond.Le) src1 src2))

(decl turin_vpcmpneqd (Xmm XmmMem) Reg)
(rule (turin_vpcmpneqd src1 src2) (turin_vpcmpd (Avx512Cond.Neq) src1 src2))

(decl turin_vpcmpged (Xmm XmmMem) Reg)
(rule (turin_vpcmpged src1 src2) (turin_vpcmpd (Avx512Cond.Ge) src1 src2))

(decl turin_vpcmpgtd (Xmm XmmMem) Reg)
(rule (turin_vpcmpgtd src1 src2) (turin_vpcmpd (Avx512Cond.Gt) src1 src2))

;; Specific comparison helpers for common conditions (I64X8)
(decl turin_vpcmpeqq (Xmm XmmMem) Reg)
(rule (turin_vpcmpeqq src1 src2) (turin_vpcmpq (Avx512Cond.Eq) src1 src2))

(decl turin_vpcmpltq (Xmm XmmMem) Reg)
(rule (turin_vpcmpltq src1 src2) (turin_vpcmpq (Avx512Cond.Lt) src1 src2))

(decl turin_vpcmpleq (Xmm XmmMem) Reg)
(rule (turin_vpcmpleq src1 src2) (turin_vpcmpq (Avx512Cond.Le) src1 src2))

(decl turin_vpcmpneqq (Xmm XmmMem) Reg)
(rule (turin_vpcmpneqq src1 src2) (turin_vpcmpq (Avx512Cond.Neq) src1 src2))

(decl turin_vpcmpgeq (Xmm XmmMem) Reg)
(rule (turin_vpcmpgeq src1 src2) (turin_vpcmpq (Avx512Cond.Ge) src1 src2))

(decl turin_vpcmpgtq (Xmm XmmMem) Reg)
(rule (turin_vpcmpgtq src1 src2) (turin_vpcmpq (Avx512Cond.Gt) src1 src2))

;; =============================================================================
;; Turin AVX-512 Compress/Expand Operations
;; =============================================================================
;;
;; VPCOMPRESSD/Q: Pack elements where mask bit is 1 to low lanes
;; VPEXPANDD/Q: Scatter consecutive elements to lanes where mask is 1

;; Note: TurinCompressStore stores directly to memory
;; For register-to-register compress, we need a helper that allocates temp storage

;; VPCOMPRESSD - compress 32-bit elements based on mask, store to memory
(decl turin_vpcompressd_mem (Xmm Reg SyntheticAmode) SideEffectNoResult)
(rule (turin_vpcompressd_mem src mask addr)
      (SideEffectNoResult.Inst
        (MInst.TurinCompressStore (OperandSize.Size32)
                                   src
                                   addr
                                   mask)))

;; VPCOMPRESSQ - compress 64-bit elements based on mask, store to memory
(decl turin_vpcompressq_mem (Xmm Reg SyntheticAmode) SideEffectNoResult)
(rule (turin_vpcompressq_mem src mask addr)
      (SideEffectNoResult.Inst
        (MInst.TurinCompressStore (OperandSize.Size64)
                                   src
                                   addr
                                   mask)))

;; VPEXPANDD - expand 32-bit elements from memory based on mask
(decl turin_vpexpandd (SyntheticAmode Reg) Xmm)
(rule (turin_vpexpandd addr mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinExpandLoad (OperandSize.Size32)
                                                  dst
                                                  addr
                                                  mask
                                                  (MergeMode.Zeroing)))))
        dst))

;; VPEXPANDQ - expand 64-bit elements from memory based on mask
(decl turin_vpexpandq (SyntheticAmode Reg) Xmm)
(rule (turin_vpexpandq addr mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinExpandLoad (OperandSize.Size64)
                                                  dst
                                                  addr
                                                  mask
                                                  (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Turin AVX-512 Gather/Scatter Operations
;; =============================================================================
;;
;; Gather: Load non-contiguous elements using indices from another vector
;; Scatter: Store elements to non-contiguous locations using indices

;; VPGATHERDD - gather 32-bit elements using 32-bit indices
(decl turin_vpgatherdd (Reg Xmm u8 i32 Reg) Xmm)
(rule (turin_vpgatherdd base indices scale disp mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (index_reg Reg (xmm_to_reg indices))
            (_ Unit (emit (MInst.TurinGather (GatherOp.Vpgatherdd)
                                              (writable_xmm_to_reg dst)
                                              base
                                              index_reg
                                              scale
                                              disp
                                              mask))))
        dst))

;; VPGATHERDQ - gather 64-bit elements using 32-bit indices
(decl turin_vpgatherdq (Reg Xmm u8 i32 Reg) Xmm)
(rule (turin_vpgatherdq base indices scale disp mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (index_reg Reg (xmm_to_reg indices))
            (_ Unit (emit (MInst.TurinGather (GatherOp.Vpgatherdq)
                                              (writable_xmm_to_reg dst)
                                              base
                                              index_reg
                                              scale
                                              disp
                                              mask))))
        dst))

;; VPGATHERQQ - gather 64-bit elements using 64-bit indices
(decl turin_vpgatherqq (Reg Xmm u8 i32 Reg) Xmm)
(rule (turin_vpgatherqq base indices scale disp mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (index_reg Reg (xmm_to_reg indices))
            (_ Unit (emit (MInst.TurinGather (GatherOp.Vpgatherqq)
                                              (writable_xmm_to_reg dst)
                                              base
                                              index_reg
                                              scale
                                              disp
                                              mask))))
        dst))

;; VPSCATTERDD - scatter 32-bit elements using 32-bit indices
;; Parameters: base pointer, indices vector, scale, displacement, source vector, mask
(decl turin_vpscatterdd (Reg Xmm u8 i32 Xmm Reg) SideEffectNoResult)
(rule (turin_vpscatterdd base indices scale disp src mask)
      (let ((src_reg Reg (xmm_to_reg src))
            (index_reg Reg (xmm_to_reg indices)))
        (SideEffectNoResult.Inst
          (MInst.TurinScatter (ScatterOp.Vpscatterdd)
                              src_reg
                              base
                              index_reg
                              scale
                              disp
                              mask))))

;; VPSCATTERDQ - scatter 64-bit elements using 32-bit indices
(decl turin_vpscatterdq (Reg Xmm u8 i32 Xmm Reg) SideEffectNoResult)
(rule (turin_vpscatterdq base indices scale disp src mask)
      (let ((src_reg Reg (xmm_to_reg src))
            (index_reg Reg (xmm_to_reg indices)))
        (SideEffectNoResult.Inst
          (MInst.TurinScatter (ScatterOp.Vpscatterdq)
                              src_reg
                              base
                              index_reg
                              scale
                              disp
                              mask))))

;; VPSCATTERQQ - scatter 64-bit elements using 64-bit indices
(decl turin_vpscatterqq (Reg Xmm u8 i32 Xmm Reg) SideEffectNoResult)
(rule (turin_vpscatterqq base indices scale disp src mask)
      (let ((src_reg Reg (xmm_to_reg src))
            (index_reg Reg (xmm_to_reg indices)))
        (SideEffectNoResult.Inst
          (MInst.TurinScatter (ScatterOp.Vpscatterqq)
                              src_reg
                              base
                              index_reg
                              scale
                              disp
                              mask))))

;; =============================================================================
;; 512-bit Load/Store (unmasked)
;; =============================================================================

;; VMOVDQU64 - load 512-bit I64X8 from memory
(decl turin_load_i64x8 (SyntheticAmode) Xmm)
(rule (turin_load_i64x8 addr)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.Turin512Load (OperandSize.Size64) dst addr))))
        dst))

;; VMOVDQU32 - load 512-bit I32X16 from memory
(decl turin_load_i32x16 (SyntheticAmode) Xmm)
(rule (turin_load_i32x16 addr)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.Turin512Load (OperandSize.Size32) dst addr))))
        dst))

;; VMOVDQU64 - store 512-bit I64X8 to memory
(decl turin_store_i64x8 (SyntheticAmode Xmm) SideEffectNoResult)
(rule (turin_store_i64x8 addr src)
      (SideEffectNoResult.Inst
        (MInst.Turin512Store (OperandSize.Size64) src addr)))

;; VMOVDQU32 - store 512-bit I32X16 to memory
(decl turin_store_i32x16 (SyntheticAmode Xmm) SideEffectNoResult)
(rule (turin_store_i32x16 addr src)
      (SideEffectNoResult.Inst
        (MInst.Turin512Store (OperandSize.Size32) src addr)))

;; =============================================================================
;; Helper functions for AVX-512 IR operations
;; =============================================================================

;; Convert Offset32 to i32 for gather/scatter displacement
(decl i32_from_offset32 (Offset32) i32)
(extern constructor i32_from_offset32 i32_from_offset32)

;; Convert Uimm8 to u8 for scale factors
(decl uimm8_value (Uimm8) u8)
(extern constructor uimm8_value uimm8_value)

;; Convert an OptionReg::Some(reg)
(decl some_reg (Reg) OptionReg)
(extern constructor some_reg some_reg)

;; Get k1 register for AVX-512 mask operations
(decl k1_reg () Reg)
(extern constructor k1_reg k1_reg)

;; Convert a Reg to WritableReg (for pinned registers like k1)
(decl reg_to_writable_reg (Reg) WritableReg)
(extern constructor reg_to_writable_reg reg_to_writable_reg)

;; =============================================================================
;; Mask initialization helpers for gather/scatter
;; =============================================================================

;; Initialize an all-1s mask register using KXNORW k1, k1, k1
;; Returns k1 with all bits set to 1.
(decl turin_init_all_ones_mask () Reg)
(rule (turin_init_all_ones_mask)
      (let ((k1 Reg (k1_reg))
            (_ Unit (emit (MInst.TurinMaskLogic (MaskAluOp.Kxnor)
                                                  (reg_to_writable_reg k1)
                                                  k1
                                                  (some_reg k1)))))
        k1))

;; Convert a vector mask (0/-1 per element) to a k-register mask using VPMOVD2M
;; Input: 512-bit vector with 32-bit elements where each element is 0 or -1
;; Output: k-register with 16 mask bits corresponding to the sign bits
(decl turin_vec_mask_to_kreg_32 (Xmm) Reg)
(rule (turin_vec_mask_to_kreg_32 vec_mask)
      (let ((k1 Reg (k1_reg))
            (_ Unit (emit (MInst.TurinVmovmsk32 (reg_to_writable_reg k1) vec_mask))))
        k1))

;; Convert a vector mask (0/-1 per element) to a k-register mask using VPMOVQ2M
;; Input: 512-bit vector with 64-bit elements where each element is 0 or -1
;; Output: k-register with 8 mask bits corresponding to the sign bits
(decl turin_vec_mask_to_kreg_64 (Xmm) Reg)
(rule (turin_vec_mask_to_kreg_64 vec_mask)
      (let ((k1 Reg (k1_reg))
            (_ Unit (emit (MInst.TurinVmovmsk64 (reg_to_writable_reg k1) vec_mask))))
        k1))

;; Convert a k-register mask to a vector mask (0/-1 per element) using VPMOVM2D
;; Input: k-register with mask bits
;; Output: 512-bit vector with 32-bit elements (0 or -1)
(decl turin_kreg_to_vec_mask_32 (Reg) Xmm)
(rule (turin_kreg_to_vec_mask_32 kreg)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinMovm2d dst kreg))))
        dst))

;; Convert a k-register mask to a vector mask (0/-1 per element) using VPMOVM2Q
;; Input: k-register with mask bits
;; Output: 512-bit vector with 64-bit elements (0 or -1)
(decl turin_kreg_to_vec_mask_64 (Reg) Xmm)
(rule (turin_kreg_to_vec_mask_64 kreg)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinMovm2q dst kreg))))
        dst))

;; =============================================================================
;; Broadcast helpers (VPBROADCASTD/Q)
;; =============================================================================

;; VPBROADCASTD - broadcast 32-bit element to all 16 lanes
(decl turin_vpbroadcastd (RegMem) Xmm)
(rule (turin_vpbroadcastd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinBroadcastd dst src))))
        dst))

;; VPBROADCASTQ - broadcast 64-bit element to all 8 lanes
(decl turin_vpbroadcastq (RegMem) Xmm)
(rule (turin_vpbroadcastq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinBroadcastq dst src))))
        dst))

;; =============================================================================
;; Permute helpers (VPERMD/Q, VPERMI2D/Q)
;; =============================================================================

;; VPERMD - permute 32-bit elements: dst[i] = src[idx[i]]
;; idx = index vector with 32-bit element indices (values 0-15 for 512-bit)
;; src = source data vector
(decl turin_vpermd (Xmm XmmMem) Xmm)
(rule (turin_vpermd idx src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpermd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 idx
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPERMQ - permute 64-bit elements: dst[i] = src[idx[i]]
;; idx = index vector with 64-bit element indices (values 0-7 for 512-bit)
;; src = source data vector
(decl turin_vpermq (Xmm XmmMem) Xmm)
(rule (turin_vpermq idx src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpermq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 idx
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPERMI2D - two-source permute 32-bit: dst = permute(src1, src2, indices)
;; indices: vector of indices where bit 4 selects src1 (0) or src2 (1), bits 3:0 select element
;; src1: first source data (values selected by index bit 4 = 0)
;; src2: second source data (values selected by index bit 4 = 1)
;; Note: indices is the destination and is modified in place
(decl turin_vpermi2d (Xmm Xmm XmmMem) Xmm)
(rule (turin_vpermi2d indices src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            ;; First copy indices to dst since vpermi2 modifies indices in place
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpord)
                                                 (OperandSize.Size32)
                                                 dst
                                                 indices
                                                 (xmm_to_xmm_mem indices)
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing))))
            ;; Now perform vpermi2d: dst is modified in place
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpermi2d)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src1
                                                 src2
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPERMI2Q - two-source permute 64-bit: dst = permute(src1, src2, indices)
;; indices: vector of indices where bit 3 selects src1 (0) or src2 (1), bits 2:0 select element
;; src1: first source data (values selected by index bit 3 = 0)
;; src2: second source data (values selected by index bit 3 = 1)
;; Note: indices is the destination and is modified in place
(decl turin_vpermi2q (Xmm Xmm XmmMem) Xmm)
(rule (turin_vpermi2q indices src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            ;; First copy indices to dst since vpermi2 modifies indices in place
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vporq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 indices
                                                 (xmm_to_xmm_mem indices)
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing))))
            ;; Now perform vpermi2q: dst is modified in place
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpermi2q)
                                                 (OperandSize.Size64)
                                                 dst
                                                 src1
                                                 src2
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Variable Shift helpers (VPSLLVD/Q, VPSRLVD/Q, VPSRAVD/Q)
;; =============================================================================

;; VPSLLVD - variable left shift 32-bit elements
;; dst[i] = data[i] << shift[i]
(decl turin_vpsllvd (Xmm XmmMem) Xmm)
(rule (turin_vpsllvd data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpsllvd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 data
                                                 shift
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPSLLVQ - variable left shift 64-bit elements
(decl turin_vpsllvq (Xmm XmmMem) Xmm)
(rule (turin_vpsllvq data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpsllvq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 data
                                                 shift
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPSRLVD - variable logical right shift 32-bit elements
(decl turin_vpsrlvd (Xmm XmmMem) Xmm)
(rule (turin_vpsrlvd data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpsrlvd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 data
                                                 shift
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPSRLVQ - variable logical right shift 64-bit elements
(decl turin_vpsrlvq (Xmm XmmMem) Xmm)
(rule (turin_vpsrlvq data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpsrlvq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 data
                                                 shift
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPSRAVD - variable arithmetic right shift 32-bit elements
(decl turin_vpsravd (Xmm XmmMem) Xmm)
(rule (turin_vpsravd data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpsravd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 data
                                                 shift
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPSRAVQ - variable arithmetic right shift 64-bit elements
(decl turin_vpsravq (Xmm XmmMem) Xmm)
(rule (turin_vpsravq data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpsravq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 data
                                                 shift
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Variable Rotate helpers (VPROLVD/Q)
;; =============================================================================

;; VPROLVD - variable rotate left 32-bit elements
;; dst[i] = data[i] <<< rotate[i] (rotate left by rotate[i] bits)
(decl turin_vprolvd (Xmm XmmMem) Xmm)
(rule (turin_vprolvd data rotate)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vprolvd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 data
                                                 rotate
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPROLVQ - variable rotate left 64-bit elements
(decl turin_vprolvq (Xmm XmmMem) Xmm)
(rule (turin_vprolvq data rotate)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vprolvq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 data
                                                 rotate
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Population Count helpers (VPOPCNTD/Q - AVX-512 VPOPCNTDQ)
;; =============================================================================

;; VPOPCNTD - population count (count 1 bits) for each 32-bit element
;; dst[i] = popcount(src[i])
;; Note: Takes Xmm (not XmmMem) because unary ops need a valid register for src1
;; even though it's ignored in encoding (vvvv=0xF). We use the input as dummy.
(decl turin_vpopcntd (Xmm) Xmm)
(rule (turin_vpopcntd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpopcntd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPOPCNTQ - population count (count 1 bits) for each 64-bit element
(decl turin_vpopcntq (Xmm) Xmm)
(rule (turin_vpopcntq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpopcntq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Conflict Detection helpers (VPCONFLICTD/Q - AVX-512 CD)
;; =============================================================================

;; VPCONFLICTD - detect conflicts (duplicates) in 32-bit elements
;; For each element, produces a bitmask indicating which prior elements have the same value
;; Used for parallel histogram construction and scatter conflict detection
;; Note: Takes Xmm (not XmmMem) because unary ops need a valid register for src1
(decl turin_vpconflictd (Xmm) Xmm)
(rule (turin_vpconflictd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpconflictd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPCONFLICTQ - detect conflicts (duplicates) in 64-bit elements
(decl turin_vpconflictq (Xmm) Xmm)
(rule (turin_vpconflictq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpconflictq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPLZCNTD - count leading zeros per 32-bit element (AVX-512CD)
;; For each element, produces the count of leading zero bits (0-32)
;; Used for find-first-set, log2 approximation, and bit manipulation
(decl turin_vplzcntd (Xmm) Xmm)
(rule (turin_vplzcntd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vplzcntd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPLZCNTQ - count leading zeros per 64-bit element (AVX-512CD)
(decl turin_vplzcntq (Xmm) Xmm)
(rule (turin_vplzcntq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vplzcntq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPABSD - absolute value per 32-bit element (AVX-512F)
;; For each element, produces the absolute value
(decl turin_vpabsd (Xmm) Xmm)
(rule (turin_vpabsd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpabsd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPABSQ - absolute value per 64-bit element (AVX-512F)
(decl turin_vpabsq (Xmm) Xmm)
(rule (turin_vpabsq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpabsq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 src  ;; Dummy src1 (ignored in encoding)
                                                 (xmm_to_xmm_mem src)  ;; Actual source
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

