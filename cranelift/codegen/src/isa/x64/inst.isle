;; =============================================================================
;; AVX-512 FMA (Fused Multiply-Add) helpers
;; =============================================================================

;; VFMADD213PS - fma F32X16: result = src2 * src1 + src3 (src1 tied to dst)
;; For Cranelift's fma(x, y, z) = x * y + z:
;; Pass x as src1 (dst), y as src2, z as src3
;; The register allocator will ensure dst gets the same register as src1 via reg_reuse_def
(decl turin_vfmadd213ps (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfmadd213ps src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfmadd213ps)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFMADD213PD - fma F64X8: result = src2 * src1 + src3 (src1 tied to dst)
;; The register allocator will ensure dst gets the same register as src1 via reg_reuse_def
(decl turin_vfmadd213pd (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfmadd213pd src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfmadd213pd)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFMSUB213PS - fms F32X16: result = src2 * src1 - src3
;; Computes (x * y) - z
(decl turin_vfmsub213ps (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfmsub213ps src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfmsub213ps)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFMSUB213PD - fms F64X8: result = src2 * src1 - src3
;; Computes (x * y) - z
(decl turin_vfmsub213pd (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfmsub213pd src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfmsub213pd)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFNMADD213PS - fnma F32X16: result = -(src2 * src1) + src3
;; Computes z - (x * y) = -(x * y) + z
(decl turin_vfnmadd213ps (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfnmadd213ps src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfnmadd213ps)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFNMADD213PD - fnma F64X8: result = -(src2 * src1) + src3
;; Computes z - (x * y) = -(x * y) + z
(decl turin_vfnmadd213pd (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfnmadd213pd src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfnmadd213pd)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFNMSUB213PS - fnms F32X16: result = -(src2 * src1) - src3
;; Computes -(x * y) - z
(decl turin_vfnmsub213ps (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfnmsub213ps src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfnmsub213ps)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VFNMSUB213PD - fnms F64X8: result = -(src2 * src1) - src3
;; Computes -(x * y) - z
(decl turin_vfnmsub213pd (Xmm Xmm XmmMem) Xmm)
(rule (turin_vfnmsub213pd src1 src2 src3)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Fma (Avx512FmaOp.Vfnmsub213pd)
                                                 dst
                                                 src1
                                                 src2
                                                 src3
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; VNNI (Vector Neural Network Instructions) helpers
;; =============================================================================

;; VPDPBUSD - Multiply unsigned bytes by signed bytes, add pairs to dword accumulator
;; dst[i] = acc[i] + dot4(src1[4i:4i+3] unsigned, src2[4i:4i+3] signed)
;; Each dword accumulator receives 4 byte products summed
(decl turin_vpdpbusd (Xmm Xmm XmmMem) Xmm)
(rule (turin_vpdpbusd acc src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Vnni (Avx512VnniOp.Vpdpbusd)
                                                  dst
                                                  acc
                                                  src1
                                                  src2
                                                  (option_mask_reg_none)
                                                  (MergeMode.Zeroing)))))
        dst))

;; VPDPBUSDS - Same as VPDPBUSD but with signed saturation
(decl turin_vpdpbusds (Xmm Xmm XmmMem) Xmm)
(rule (turin_vpdpbusds acc src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Vnni (Avx512VnniOp.Vpdpbusds)
                                                  dst
                                                  acc
                                                  src1
                                                  src2
                                                  (option_mask_reg_none)
                                                  (MergeMode.Zeroing)))))
        dst))

;; VPDPWSSD - Multiply signed words, add pairs to dword accumulator
;; dst[i] = acc[i] + dot2(src1[2i:2i+1], src2[2i:2i+1])
;; Each dword accumulator receives 2 word products summed
(decl turin_vpdpwssd (Xmm Xmm XmmMem) Xmm)
(rule (turin_vpdpwssd acc src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Vnni (Avx512VnniOp.Vpdpwssd)
                                                  dst
                                                  acc
                                                  src1
                                                  src2
                                                  (option_mask_reg_none)
                                                  (MergeMode.Zeroing)))))
        dst))

;; VPDPWSSDS - Same as VPDPWSSD but with signed saturation
(decl turin_vpdpwssds (Xmm Xmm XmmMem) Xmm)
(rule (turin_vpdpwssds acc src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Vnni (Avx512VnniOp.Vpdpwssds)
                                                  dst
                                                  acc
                                                  src1
                                                  src2
                                                  (option_mask_reg_none)
                                                  (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; VP2INTERSECT helpers (Hash join acceleration)
;; =============================================================================

;; VP2INTERSECTD - Compare 32-bit elements from two vectors
;; Produces TWO mask outputs (consecutive k-registers):
;; - First mask (returned): For each element in src1, set if it matches ANY element in src2
;; - Second mask (dst+1): For each element in src2, set if it matches ANY element in src1
;; Note: The hardware implicitly writes to both dst_k and dst_k+1.
;; dst_k must be an even k-register (k0, k2, k4, k6).
(decl turin_vp2intersectd (Xmm XmmMem) Reg)
(rule (turin_vp2intersectd src1 src2)
      (let ((dst WritableReg (temp_writable_reg $I64))
            (_ Unit (emit (MInst.TurinVp2Intersect (Vp2IntersectOp.Vp2intersectd)
                                                    dst
                                                    src1
                                                    src2))))
        dst))

;; VP2INTERSECTQ - Compare 64-bit elements from two vectors
;; Same semantics as VP2INTERSECTD but for 64-bit elements.
(decl turin_vp2intersectq (Xmm XmmMem) Reg)
(rule (turin_vp2intersectq src1 src2)
      (let ((dst WritableReg (temp_writable_reg $I64))
            (_ Unit (emit (MInst.TurinVp2Intersect (Vp2IntersectOp.Vp2intersectq)
                                                    dst
                                                    src1
                                                    src2))))
        dst))

