;; Integer-Double Conversion helpers (VCVTDQ2PD, VCVTPD2DQ, VCVTTPD2DQ)
;; =============================================================================

;; VCVTDQ2PD - Convert packed i32 to packed f64 (I32X8 -> F64X8)
(decl turin_vcvtdq2pd (XmmMem) Xmm)
(rule (turin_vcvtdq2pd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vcvtdq2pd)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VCVTPD2DQ - Convert packed f64 to packed i32 with rounding (F64X8 -> I32X8)
