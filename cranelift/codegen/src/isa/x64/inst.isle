;; =============================================================================
;; Shuffle/Permute helpers
;; =============================================================================

;; VPSHUFB - Shuffle bytes using indices from another vector
;; For each byte in dst, the corresponding byte in indices selects which byte from src to use
;; If index[7] is 1, the result byte is 0
(decl turin_vpshufb (Xmm XmmMem) Xmm)
(rule (turin_vpshufb src indices)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpshufb)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src
                                                 indices
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Multiply-Add helpers (dot products)
;; =============================================================================

;; VPMADDWD - Multiply packed words, add adjacent pairs to dwords
;; dst[i] = src1[2*i] * src2[2*i] + src1[2*i+1] * src2[2*i+1]
(decl turin_vpmaddwd (Xmm XmmMem) Xmm)
(rule (turin_vpmaddwd src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpmaddwd)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src1
                                                 src2
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPMADDUBSW - Multiply packed unsigned/signed bytes, add adjacent pairs to words
;; dst[i] = saturate16(src1_u8[2*i] * src2_s8[2*i] + src1_u8[2*i+1] * src2_s8[2*i+1])
(decl turin_vpmaddubsw (Xmm XmmMem) Xmm)
(rule (turin_vpmaddubsw src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpmaddubsw)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src1
                                                 src2
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Masked unsigned min/max operations (I32X16 / I64X8)
;; =============================================================================

;; Masked VPMINUD - unsigned min I32X16
(decl turin_masked_vpminud (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpminud mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpminud) mask src1 src2 passthrough))

;; Masked VPMAXUD - unsigned max I32X16
(decl turin_masked_vpmaxud (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpmaxud mask src1 src2 passthrough)
      (turin_masked_alu_d (Avx512AluOp.Vpmaxud) mask src1 src2 passthrough))

;; Masked VPMINUQ - unsigned min I64X8
(decl turin_masked_vpminuq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpminuq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpminuq) mask src1 src2 passthrough))

;; Masked VPMAXUQ - unsigned max I64X8
(decl turin_masked_vpmaxuq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpmaxuq mask src1 src2 passthrough)
      (turin_masked_alu_q (Avx512AluOp.Vpmaxuq) mask src1 src2 passthrough))

;; =============================================================================
;; Masked FP ALU helpers (F32X16 / F64X8)
;; =============================================================================
;; Strategy: Execute with zeroing mask, then blend with passthrough using
;; VPBLENDMD/Q (integer blend works fine for FP bits)

;; Generic zeroing FP ALU (32-bit elements / single-precision)
(decl turin_zeroing_fp_alu_ps (Avx512FpAluOp Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_fp_alu_ps op mask src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512FpAlu op
                                                  dst
                                                  src1
                                                  src2
                                                  mask_reg
                                                  (MergeMode.Zeroing)))))
        dst))

;; Generic zeroing FP ALU (64-bit elements / double-precision)
(decl turin_zeroing_fp_alu_pd (Avx512FpAluOp Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_fp_alu_pd op mask src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512FpAlu op
                                                  dst
                                                  src1
                                                  src2
                                                  mask_reg
                                                  (MergeMode.Zeroing)))))
        dst))

;; Generic masked FP ALU (32-bit elements / single-precision)
;; Strategy: Execute with zeroing mask, then blend with passthrough
;; Uses VPBLENDMD since it works on bits (same 32-bit element size)
(decl turin_masked_fp_alu_ps (Avx512FpAluOp Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_fp_alu_ps op mask src1 src2 passthrough)
      (let ((raw_result Xmm (turin_zeroing_fp_alu_ps op mask src1 src2)))
        ;; Blend: where mask=1 take raw_result, where mask=0 take passthrough
        (turin_vpblendmd mask passthrough (xmm_to_xmm_mem raw_result))))

;; Generic masked FP ALU (64-bit elements / double-precision)
;; Strategy: Execute with zeroing mask, then blend with passthrough
;; Uses VPBLENDMQ since it works on bits (same 64-bit element size)
(decl turin_masked_fp_alu_pd (Avx512FpAluOp Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_fp_alu_pd op mask src1 src2 passthrough)
      (let ((raw_result Xmm (turin_zeroing_fp_alu_pd op mask src1 src2)))
        ;; Blend: where mask=1 take raw_result, where mask=0 take passthrough
        (turin_vpblendmq mask passthrough (xmm_to_xmm_mem raw_result))))

;; Masked VADDPS - add F32X16
(decl turin_masked_vaddps (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vaddps mask src1 src2 passthrough)
      (turin_masked_fp_alu_ps (Avx512FpAluOp.Vaddps) mask src1 src2 passthrough))

;; Masked VADDPD - add F64X8
(decl turin_masked_vaddpd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vaddpd mask src1 src2 passthrough)
      (turin_masked_fp_alu_pd (Avx512FpAluOp.Vaddpd) mask src1 src2 passthrough))

;; Masked VSUBPS - subtract F32X16
(decl turin_masked_vsubps (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vsubps mask src1 src2 passthrough)
      (turin_masked_fp_alu_ps (Avx512FpAluOp.Vsubps) mask src1 src2 passthrough))

;; Masked VSUBPD - subtract F64X8
(decl turin_masked_vsubpd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vsubpd mask src1 src2 passthrough)
      (turin_masked_fp_alu_pd (Avx512FpAluOp.Vsubpd) mask src1 src2 passthrough))

;; Masked VMULPS - multiply F32X16
(decl turin_masked_vmulps (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vmulps mask src1 src2 passthrough)
      (turin_masked_fp_alu_ps (Avx512FpAluOp.Vmulps) mask src1 src2 passthrough))

;; Masked VMULPD - multiply F64X8
(decl turin_masked_vmulpd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vmulpd mask src1 src2 passthrough)
      (turin_masked_fp_alu_pd (Avx512FpAluOp.Vmulpd) mask src1 src2 passthrough))

;; Masked VDIVPS - divide F32X16
(decl turin_masked_vdivps (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vdivps mask src1 src2 passthrough)
      (turin_masked_fp_alu_ps (Avx512FpAluOp.Vdivps) mask src1 src2 passthrough))

;; Masked VDIVPD - divide F64X8
(decl turin_masked_vdivpd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vdivpd mask src1 src2 passthrough)
      (turin_masked_fp_alu_pd (Avx512FpAluOp.Vdivpd) mask src1 src2 passthrough))

;; Masked VMINPS - min F32X16
(decl turin_masked_vminps (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vminps mask src1 src2 passthrough)
      (turin_masked_fp_alu_ps (Avx512FpAluOp.Vminps) mask src1 src2 passthrough))

;; Masked VMINPD - min F64X8
(decl turin_masked_vminpd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vminpd mask src1 src2 passthrough)
      (turin_masked_fp_alu_pd (Avx512FpAluOp.Vminpd) mask src1 src2 passthrough))

;; Masked VMAXPS - max F32X16
(decl turin_masked_vmaxps (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vmaxps mask src1 src2 passthrough)
      (turin_masked_fp_alu_ps (Avx512FpAluOp.Vmaxps) mask src1 src2 passthrough))

;; Masked VMAXPD - max F64X8
(decl turin_masked_vmaxpd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vmaxpd mask src1 src2 passthrough)
      (turin_masked_fp_alu_pd (Avx512FpAluOp.Vmaxpd) mask src1 src2 passthrough))

;; =============================================================================
;; Masked shift operations - execute with zeroing mask, then blend with passthru
;; =============================================================================

;; Generic zeroing shift for 32-bit elements
(decl turin_zeroing_shift_d (Avx512AluOp Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_shift_d op mask data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512Alu op
                                                (OperandSize.Size32)
                                                dst data shift
                                                mask_reg (MergeMode.Zeroing)))))
        dst))

;; Generic zeroing shift for 64-bit elements
(decl turin_zeroing_shift_q (Avx512AluOp Reg Xmm XmmMem) Xmm)
(rule (turin_zeroing_shift_q op mask data shift)
      (let ((dst WritableXmm (temp_writable_xmm))
            (mask_reg OptionMaskReg (turin_mask_reg mask))
            (_ Unit (emit (MInst.TurinAvx512Alu op
                                                (OperandSize.Size64)
                                                dst data shift
                                                mask_reg (MergeMode.Zeroing)))))
        dst))

;; Generic masked shift for 32-bit elements - zeroing + blend
(decl turin_masked_shift_d (Avx512AluOp Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_shift_d op mask data shift passthrough)
      (let ((raw_result Xmm (turin_zeroing_shift_d op mask data shift)))
        (turin_vpblendmd mask passthrough (xmm_to_xmm_mem raw_result))))

;; Generic masked shift for 64-bit elements - zeroing + blend
(decl turin_masked_shift_q (Avx512AluOp Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_shift_q op mask data shift passthrough)
      (let ((raw_result Xmm (turin_zeroing_shift_q op mask data shift)))
        (turin_vpblendmq mask passthrough (xmm_to_xmm_mem raw_result))))

;; Masked VPSLLVD - variable left shift I32X16
(decl turin_masked_vpsllvd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsllvd mask data shift passthrough)
      (turin_masked_shift_d (Avx512AluOp.Vpsllvd) mask data shift passthrough))

;; Masked VPSLLVQ - variable left shift I64X8
(decl turin_masked_vpsllvq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsllvq mask data shift passthrough)
      (turin_masked_shift_q (Avx512AluOp.Vpsllvq) mask data shift passthrough))

;; Masked VPSRLVD - variable logical right shift I32X16
(decl turin_masked_vpsrlvd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsrlvd mask data shift passthrough)
      (turin_masked_shift_d (Avx512AluOp.Vpsrlvd) mask data shift passthrough))

;; Masked VPSRLVQ - variable logical right shift I64X8
(decl turin_masked_vpsrlvq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsrlvq mask data shift passthrough)
      (turin_masked_shift_q (Avx512AluOp.Vpsrlvq) mask data shift passthrough))

;; Masked VPSRAVD - variable arithmetic right shift I32X16
(decl turin_masked_vpsravd (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsravd mask data shift passthrough)
      (turin_masked_shift_d (Avx512AluOp.Vpsravd) mask data shift passthrough))

;; Masked VPSRAVQ - variable arithmetic right shift I64X8
(decl turin_masked_vpsravq (Reg Xmm XmmMem Xmm) Xmm)
(rule (turin_masked_vpsravq mask data shift passthrough)
      (turin_masked_shift_q (Avx512AluOp.Vpsravq) mask data shift passthrough))

;; =============================================================================
;; AVX-512 Extract Lane operations (VEXTRACTI32X4, VEXTRACTI64X2)
;; =============================================================================

;; VEXTRACTI32X4 - Extract 128-bit lane from 512-bit vector (as I32X4)
;; lane: 0-3 selects which 128-bit lane to extract
(decl turin_vextracti32x4 (Xmm u8) Xmm)
(rule (turin_vextracti32x4 src lane)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Extract (Avx512ExtractOp.Vextracti32x4)
                                                     dst src lane))))
        dst))

;; VEXTRACTI64X2 - Extract 128-bit lane from 512-bit vector (as I64X2)
;; lane: 0-3 selects which 128-bit lane to extract
(decl turin_vextracti64x2 (Xmm u8) Xmm)
(rule (turin_vextracti64x2 src lane)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Extract (Avx512ExtractOp.Vextracti64x2)
                                                     dst src lane))))
        dst))

;; =============================================================================
;; AVX-512 FP Special operations (VRCP14PS/PD, VRSQRT14PS/PD)
;; =============================================================================

;; VRCP14PS - Reciprocal approximation of F32X16 elements (1/x)
(decl turin_vrcp14ps (XmmMem) Xmm)
(rule (turin_vrcp14ps src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512FpSpecial (Avx512FpSpecialOp.Vrcp14ps)
                                                       dst src
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; VRCP14PD - Reciprocal approximation of F64X8 elements (1/x)
(decl turin_vrcp14pd (XmmMem) Xmm)
(rule (turin_vrcp14pd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512FpSpecial (Avx512FpSpecialOp.Vrcp14pd)
                                                       dst src
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; VRSQRT14PS - Reciprocal square root approximation of F32X16 (1/sqrt(x))
(decl turin_vrsqrt14ps (XmmMem) Xmm)
(rule (turin_vrsqrt14ps src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512FpSpecial (Avx512FpSpecialOp.Vrsqrt14ps)
                                                       dst src
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; VRSQRT14PD - Reciprocal square root approximation of F64X8 (1/sqrt(x))
(decl turin_vrsqrt14pd (XmmMem) Xmm)
(rule (turin_vrsqrt14pd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512FpSpecial (Avx512FpSpecialOp.Vrsqrt14pd)
                                                       dst src
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))
