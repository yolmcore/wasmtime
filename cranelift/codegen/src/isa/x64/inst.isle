      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vcvttpd2dq)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

