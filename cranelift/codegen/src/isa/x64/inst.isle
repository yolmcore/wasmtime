                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VCVTPD2QQ - convert packed f64 to packed i64 with rounding (F64X8 -> I64X8)
(decl turin_vcvtpd2qq (XmmMem) Xmm)
(rule (turin_vcvtpd2qq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vcvtpd2qq)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VCVTTPD2QQ - convert packed f64 to packed i64 with truncation (F64X8 -> I64X8)
(decl turin_vcvttpd2qq (XmmMem) Xmm)
(rule (turin_vcvttpd2qq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vcvttpd2qq)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VCVTPS2PD - convert packed f32 to packed f64 (F32X8 -> F64X8)
(decl turin_vcvtps2pd (XmmMem) Xmm)
(rule (turin_vcvtps2pd src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vcvtps2pd)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VCVTPD2PS - convert packed f64 to packed f32 (F64X8 -> F32X8)
(decl turin_vcvtpd2ps (XmmMem) Xmm)
(rule (turin_vcvtpd2ps src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vcvtpd2ps)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Vector Alignment helpers (VALIGND, VALIGNQ)
;; =============================================================================

;; VALIGND - Align 32-bit elements from concatenation of two vectors
;; dst = (src1 || src2) >> (imm8 * 32)
;; Extracts 16 consecutive 32-bit elements from the concatenation of src1:src2
(decl turin_valignd (Xmm XmmMem u8) Xmm)
(rule (turin_valignd src1 src2 imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512Align (Avx512AlignOp.Valignd)
                                                   dst
                                                   src1
                                                   src2_rm
                                                   imm8
                                                   (option_mask_reg_none)
                                                   (MergeMode.Zeroing)))))
        dst))

;; VALIGNQ - Align 64-bit elements from concatenation of two vectors
;; dst = (src1 || src2) >> (imm8 * 64)
;; Extracts 8 consecutive 64-bit elements from the concatenation of src1:src2
(decl turin_valignq (Xmm XmmMem u8) Xmm)
(rule (turin_valignq src1 src2 imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512Align (Avx512AlignOp.Valignq)
                                                   dst
                                                   src1
                                                   src2_rm
                                                   imm8
                                                   (option_mask_reg_none)
                                                   (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Ternary Logic helpers (VPTERNLOGD/Q)
;; =============================================================================
;;
;; These compute arbitrary 3-input boolean functions based on an 8-bit truth table.
;; For each bit position i in the output:
;;   bit_index = (src1[i] << 2) | (src2[i] << 1) | src3[i]
;;   result[i] = imm8[bit_index]
;;
;; Common imm8 values:
;;   0x00 = zero (clear all bits)
;;   0xFF = all ones (set all bits)
;;   0x80 = AND(a, b, c) = a & b & c
;;   0xFE = OR(a, b, c) = a | b | c
;;   0x96 = XOR3(a, b, c) = a ^ b ^ c
;;   0xCA = blend(a, b, c) = (a & b) | (~a & c)
;;   0xF8 = (a | b) & c
;;   0xEA = (a | b) | c = a | b | c (same as 0xFE)
;;   0xE8 = (a & b) | (b & c) | (a & c) = majority
;;   0x28 = a & b & ~c
;;   0x78 = a ^ (b & c)

;; VPTERNLOGD - ternary logic on 32-bit elements
;; dst = ternlog(src1, src2, src3, imm8)
;; Note: dst is tied to src1 (the instruction modifies src1 in place)
(decl turin_vpternlogd (Xmm Xmm XmmMem u8) Xmm)
(rule (turin_vpternlogd src1 src2 src3 imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            ;; First move src1 to dst since vpternlog modifies the first operand
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpord)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src1
                                                 (xmm_to_xmm_mem src1)
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing))))
            (src3_rm RegMem (turin_xmm_mem_to_reg_mem src3))
            (_ Unit (emit (MInst.TurinAvx512Ternlog (OperandSize.Size32)
                                                     dst
                                                     (writable_xmm_to_xmm dst)
                                                     src2
                                                     src3_rm
                                                     imm8
                                                     (option_mask_reg_none)
                                                     (MergeMode.Zeroing)))))
        dst))

;; VPTERNLOGQ - ternary logic on 64-bit elements
;; dst = ternlog(src1, src2, src3, imm8)
(decl turin_vpternlogq (Xmm Xmm XmmMem u8) Xmm)
(rule (turin_vpternlogq src1 src2 src3 imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            ;; First move src1 to dst since vpternlog modifies the first operand
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vporq)
                                                 (OperandSize.Size64)
                                                 dst
                                                 src1
                                                 (xmm_to_xmm_mem src1)
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing))))
            (src3_rm RegMem (turin_xmm_mem_to_reg_mem src3))
            (_ Unit (emit (MInst.TurinAvx512Ternlog (OperandSize.Size64)
                                                     dst
                                                     (writable_xmm_to_xmm dst)
                                                     src2
                                                     src3_rm
                                                     imm8
                                                     (option_mask_reg_none)
                                                     (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Register-form Compress/Expand helpers
;; =============================================================================

;; VPCOMPRESSD register form - compress 32-bit elements based on mask
(decl turin_vpcompressd_reg (Reg Xmm) Xmm)
(rule (turin_vpcompressd_reg mask src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinCompressReg (OperandSize.Size32)
                                                   dst
                                                   src
                                                   mask))))
        dst))

;; VPCOMPRESSQ register form - compress 64-bit elements based on mask
(decl turin_vpcompressq_reg (Reg Xmm) Xmm)
(rule (turin_vpcompressq_reg mask src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinCompressReg (OperandSize.Size64)
                                                   dst
                                                   src
                                                   mask))))
        dst))

;; VPEXPANDD register form - expand 32-bit elements based on mask
(decl turin_vpexpandd_reg (Reg Xmm) Xmm)
(rule (turin_vpexpandd_reg mask src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinExpandReg (OperandSize.Size32)
                                                 dst
                                                 src
                                                 mask
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPEXPANDQ register form - expand 64-bit elements based on mask
(decl turin_vpexpandq_reg (Reg Xmm) Xmm)
(rule (turin_vpexpandq_reg mask src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinExpandReg (OperandSize.Size64)
                                                 dst
                                                 src
                                                 mask
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Masked Load/Store helpers
;; =============================================================================

;; VMOVDQU32 with mask - masked load for 32-bit elements
(decl turin_masked_load_i32x16 (SyntheticAmode Reg Xmm) Xmm)
(rule (turin_masked_load_i32x16 addr mask passthru)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinMaskedLoad (OperandSize.Size32)
                                                  dst
                                                  addr
                                                  mask
                                                  (MergeMode.Merging)))))
        ;; Copy passthru to dst first, then the masked load merges
        (turin_vpblendmd mask passthru (xmm_to_xmm_mem (turin_masked_load_raw_i32x16 addr mask)))))

;; Raw masked load (no merge with passthru)
(decl turin_masked_load_raw_i32x16 (SyntheticAmode Reg) Xmm)
(rule (turin_masked_load_raw_i32x16 addr mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinMaskedLoad (OperandSize.Size32)
                                                  dst
                                                  addr
                                                  mask
                                                  (MergeMode.Zeroing)))))
        dst))

;; VMOVDQU64 with mask - masked load for 64-bit elements
(decl turin_masked_load_i64x8 (SyntheticAmode Reg Xmm) Xmm)
(rule (turin_masked_load_i64x8 addr mask passthru)
      (turin_vpblendmq mask passthru (xmm_to_xmm_mem (turin_masked_load_raw_i64x8 addr mask))))

;; Raw masked load (no merge with passthru)
(decl turin_masked_load_raw_i64x8 (SyntheticAmode Reg) Xmm)
(rule (turin_masked_load_raw_i64x8 addr mask)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinMaskedLoad (OperandSize.Size64)
                                                  dst
                                                  addr
                                                  mask
                                                  (MergeMode.Zeroing)))))
        dst))

;; VMOVDQU32 with mask - masked store for 32-bit elements
(decl turin_masked_store_i32x16 (SyntheticAmode Reg Xmm) SideEffectNoResult)
(rule (turin_masked_store_i32x16 addr mask src)
      (SideEffectNoResult.Inst
        (MInst.TurinMaskedStore (OperandSize.Size32) src addr mask)))

;; VMOVDQU64 with mask - masked store for 64-bit elements
(decl turin_masked_store_i64x8 (SyntheticAmode Reg Xmm) SideEffectNoResult)
(rule (turin_masked_store_i64x8 addr mask src)
      (SideEffectNoResult.Inst
        (MInst.TurinMaskedStore (OperandSize.Size64) src addr mask)))

;; =============================================================================
;; Immediate Rotate helpers (VPROLD/VPROLQ/VPRORD/VPRORQ)
;; =============================================================================

;; VPROLD - rotate left 32-bit elements by immediate
(decl turin_vprold (XmmMem u8) Xmm)
(rule (turin_vprold src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmRotate (OperandSize.Size32)
                                                       dst
                                                       src_rm
                                                       imm8
                                                       true  ;; is_left = true
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; VPROLQ - rotate left 64-bit elements by immediate
(decl turin_vprolq (XmmMem u8) Xmm)
(rule (turin_vprolq src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmRotate (OperandSize.Size64)
                                                       dst
                                                       src_rm
                                                       imm8
                                                       true  ;; is_left = true
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; VPRORD - rotate right 32-bit elements by immediate
(decl turin_vprord (XmmMem u8) Xmm)
(rule (turin_vprord src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmRotate (OperandSize.Size32)
                                                       dst
                                                       src_rm
                                                       imm8
                                                       false  ;; is_left = false
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; VPRORQ - rotate right 64-bit elements by immediate
(decl turin_vprorq (XmmMem u8) Xmm)
(rule (turin_vprorq src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmRotate (OperandSize.Size64)
                                                       dst
                                                       src_rm
                                                       imm8
                                                       false  ;; is_left = false
                                                       (option_mask_reg_none)
                                                       (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Immediate Shuffle helpers (VPSHUFD, VPSHUFHW, VPSHUFLW)
;; =============================================================================

;; VPSHUFD - Shuffle packed dwords according to immediate
;; Each 2-bit field in imm8 selects one of 4 dwords within each 128-bit lane
;; Result: For each 128-bit lane, dst[i] = src[imm8[i*2+1:i*2]] for i=0..3
(decl turin_vpshufd (XmmMem u8) Xmm)
(rule (turin_vpshufd src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmShuffle (Avx512ImmShuffleOp.Vpshufd)
                                                        dst
                                                        src_rm
                                                        imm8
                                                        (option_mask_reg_none)
                                                        (MergeMode.Zeroing)))))
        dst))

;; VPSHUFHW - Shuffle packed high words according to immediate
;; Shuffles the high 4 words (bits 64-127) of each 128-bit lane
;; Low 4 words are copied unchanged
(decl turin_vpshufhw (XmmMem u8) Xmm)
(rule (turin_vpshufhw src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmShuffle (Avx512ImmShuffleOp.Vpshufhw)
                                                        dst
                                                        src_rm
                                                        imm8
                                                        (option_mask_reg_none)
                                                        (MergeMode.Zeroing)))))
        dst))

;; VPSHUFLW - Shuffle packed low words according to immediate
;; Shuffles the low 4 words (bits 0-63) of each 128-bit lane
;; High 4 words are copied unchanged
(decl turin_vpshuflw (XmmMem u8) Xmm)
(rule (turin_vpshuflw src imm8)
      (let ((dst WritableXmm (temp_writable_xmm))
            (src_rm RegMem (turin_xmm_mem_to_reg_mem src))
            (_ Unit (emit (MInst.TurinAvx512ImmShuffle (Avx512ImmShuffleOp.Vpshuflw)
                                                        dst
                                                        src_rm
                                                        imm8
                                                        (option_mask_reg_none)
                                                        (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; FP Compare helpers (VCMPPS/VCMPPD)
;; =============================================================================

;; VCMPPS - compare packed single-precision floats to k-mask
;; Returns the k-register containing the comparison result mask
(decl turin_vcmpps (Xmm XmmMem u8) Reg)
(rule (turin_vcmpps src1 src2 imm8)
      (let ((dst WritableReg (temp_writable_reg $I64))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512FpCmp (OperandSize.Size32)
                                                   dst
                                                   src1
                                                   src2_rm
                                                   imm8
                                                   (option_mask_reg_none)))))
        dst))

;; VCMPPD - compare packed double-precision floats to k-mask
;; Returns the k-register containing the comparison result mask
(decl turin_vcmppd (Xmm XmmMem u8) Reg)
(rule (turin_vcmppd src1 src2 imm8)
      (let ((dst WritableReg (temp_writable_reg $I64))
            (src2_rm RegMem (turin_xmm_mem_to_reg_mem src2))
            (_ Unit (emit (MInst.TurinAvx512FpCmp (OperandSize.Size64)
                                                   dst
                                                   src1
                                                   src2_rm
                                                   imm8
                                                   (option_mask_reg_none)))))
        dst))

