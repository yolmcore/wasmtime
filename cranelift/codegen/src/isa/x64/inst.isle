;; VPACKSSDW - Pack 32-bit signed to 16-bit signed with saturation
;; Pack and saturate src1 and src2 doublewords to words in dst
(decl turin_vpackssdw (Xmm XmmMem) Xmm)
(rule (turin_vpackssdw src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Alu (Avx512AluOp.Vpackssdw)
                                                 (OperandSize.Size32)
                                                 dst
                                                 src1
                                                 src2
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

