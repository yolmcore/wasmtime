;; VPUNPCKLDQ - Unpack low doublewords
(decl turin_vpunpckldq (Xmm XmmMem) Xmm)
(rule (turin_vpunpckldq src1 src2)
      (let ((dst WritableXmm (temp_writable_xmm))
