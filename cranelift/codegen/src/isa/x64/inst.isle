                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPMOVQW - Truncate packed qwords to words (I64X8 -> I16X8)
(decl turin_vpmovqw (XmmMem) Xmm)
(rule (turin_vpmovqw src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vpmovqw)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPMOVWB - Truncate packed words to bytes (I16X32 -> I8X32)
(decl turin_vpmovwb (XmmMem) Xmm)
