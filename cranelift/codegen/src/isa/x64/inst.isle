(rule (turin_vpmovsxdq src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vpmovsxdq)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; =============================================================================
;; Truncation helpers (VPMOVDB/DW/QB/QD/QW/WB and saturating variants)
;; =============================================================================

;; VPMOVDB - Truncate packed dwords to bytes (I32X16 -> I8X16)
(decl turin_vpmovdb (XmmMem) Xmm)
(rule (turin_vpmovdb src)
      (let ((dst WritableXmm (temp_writable_xmm))
            (_ Unit (emit (MInst.TurinAvx512Cvt (Avx512CvtOp.Vpmovdb)
                                                 dst
                                                 src
                                                 (option_mask_reg_none)
                                                 (MergeMode.Zeroing)))))
        dst))

;; VPMOVDW - Truncate packed dwords to words (I32X16 -> I16X16)
