(rule (x64_unpcklpd src1 src2) (x64_unpcklpd_a_or_avx src1 src2))

(decl x64_unpckhps (Xmm XmmMem) Xmm)
(rule (x64_unpckhps src1 src2) (x64_unpckhps_a_or_avx src1 src2))

